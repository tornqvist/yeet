{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "node",
    "module": "es2020",
    "noImplicitAny": true,
    "skipLibCheck": false,
    "sourceMap": true,
    "strict": true,
    "target": "es2020"
  }
}
